# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgres://erp_user:erp_password@localhost:5432/erp_diploma
DATABASE_SSL=false

# App
APP_BASE_URL=http://localhost:4000
SESSION_SECRET=change-me-generate-a-long-random-string
COOKIE_SECURE=false

# File storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Notifications: console | msg91 | twilio | sendgrid (console is the only implemented provider for now)
SMS_PROVIDER=console
EMAIL_PROVIDER=console

# Web app (Vite) - the API base URL the browser should call. Leave BLANK
# for local dev — apps/web/src/api/client.ts then calls the API on
# whatever host the page itself was opened from (localhost, a LAN IP,
# whatever), which is what actually lets both work interchangeably without
# a rebuild/restart. Only set this explicitly for a real deployment, where
# it's baked in at build time (see docker-compose.prod.yml).
VITE_API_BASE_URL=

# Seed script (creates the first super-admin login if no staff exist yet)
SEED_ADMIN_EMAIL=admin@institute.local
SEED_ADMIN_PASSWORD=change-me-on-first-login

# Support contract / license (see docs/OPERATIONS.md "Support contract / license")
# Leave LICENSE_SERVER_URL/LICENSE_KEY blank locally — the banner just shows
# "not configured" and nothing else is affected.
LICENSE_SERVER_URL=
LICENSE_KEY=
LICENSE_INSTANCE_ID_PATH=./data/instance-id
LICENSE_CACHE_PATH=./data/license-cache.json
VENDOR_SUPPORT_CONTACT=

# Hosted deployment only (see docs/DEPLOYMENT.md) — used by
# docker-compose.prod.yml + Caddyfile, not needed for local dev.
DOMAIN=erp.yourclientdomain.com
LETSENCRYPT_EMAIL=you@yourcompany.example
POSTGRES_PASSWORD=generate-a-long-random-string-for-production
# Uncomment on the production server so plain `docker compose ...` (no -f)
# targets the standalone prod stack automatically:
# COMPOSE_FILE=docker-compose.prod.yml
