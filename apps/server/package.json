{
  "name": "@erp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:create": "tsx src/db/migrate.ts --create",
    "seed": "tsx src/db/seeds/run.ts",
    "license:instance-id": "node dist/scripts/printInstanceId.js",
    "license:instance-id:dev": "tsx src/scripts/printInstanceId.ts"
  },
  "dependencies": {
    "@erp/shared": "*",
    "bcrypt": "^5.1.1",
    "express-mysql-session": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "exceljs": "^4.4.0",
    "express-session": "^1.18.1",
    "multer": "^2.0.1",
    "mysql2": "^3.11.4",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express-mysql-session": "^3.0.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
