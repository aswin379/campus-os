# Copy to .env (in this directory) and fill in real values. This is a
# separate deployable service from the main ERP — see apps/license-server's
# own docs for why. Never commit the real .env file.

PORT=4100
DB_PATH=./data/license-server.db

# Shared secret protecting the admin endpoints and admin.html page.
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=change-me-generate-a-long-random-string
