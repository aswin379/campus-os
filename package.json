{
  "name": "erp-diploma",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/server && npm run build --workspace=apps/web",
    "migrate": "npm run migrate --workspace=apps/server",
    "migrate:down": "npm run migrate:down --workspace=apps/server",
    "seed": "npm run seed --workspace=apps/server",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
